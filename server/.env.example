# ================================
# SalesNest AI CRM — Environment Variables
# Copy this file to .env and fill in your values
# ================================

# Application
NODE_ENV=development
PORT=5000

# MongoDB (REQUIRED)
MONGO_URI=mongodb://localhost:27017/salesnest

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (REQUIRED - use strong random strings in production)
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Client URL (CORS)
CLIENT_URL=http://localhost:3000

# Meta / WhatsApp Cloud API
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_webhook_verify_token
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WA_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# Google Ads Lead Form
GOOGLE_LEAD_KEY=your_google_lead_form_webhook_key

# IndiaMART
INDIAMART_CRM_KEY=your_indiamart_crm_key

# TradeIndia
TRADEINDIA_USERID=your_tradeindia_user_id
TRADEINDIA_KEY=your_tradeindia_api_key
TRADEINDIA_PROFILE_ID=your_tradeindia_profile_id

# JustDial
JUSTDIAL_TOKEN=your_justdial_api_token

# AWS S3 (File Uploads)
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# AI Integrations
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Webhooks
LEAD_WEBHOOK_SECRET=your_secret_here
